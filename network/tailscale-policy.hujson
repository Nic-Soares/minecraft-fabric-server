// Política de acesso do tailnet. Este arquivo é a fonte da verdade:
// mude aqui, faça commit e cole o conteúdo em
// https://login.tailscale.com/admin/acls
//
// Formato HuJSON: JSON com comentários e vírgula no fim permitidos.
{
	"hosts": {
		// IP Tailscale do Mac que roda o servidor. Descubra com:
		// /Applications/Tailscale.app/Contents/MacOS/Tailscale ip -4
		"minecraft": "100.x.y.z",
	},

	"grants": [
		// Seus próprios dispositivos continuam com acesso total entre si.
		{
			"src": ["autogroup:member"],
			"dst": ["*"],
			"ip":  ["*"],
		},
		// Qualquer origem, incluindo os amigos com quem o Mac foi
		// compartilhado, alcança só a porta do jogo no Mac. A 25575 (RCON)
		// e qualquer outra porta ficam invisíveis para eles.
		// "*" é o que o Tailscale documenta como incluindo usuários de
		// compartilhamento; "autogroup:shared" não liberou o tráfego.
		{
			"src": ["*"],
			"dst": ["minecraft"],
			"ip":  ["tcp:25565"],
		},
	],
}
