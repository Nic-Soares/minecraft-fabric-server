#!/usr/bin/env bash
# Blocks secrets and binaries before the commit.
set -euo pipefail
fail=0

while IFS= read -r f; do
  case "$f" in
    *.jar|*.zst|*.mca|*.dat) echo "pre-commit: binary blocked: $f"; fail=1 ;;
    .env|*/.env)             echo "pre-commit: secret file blocked: $f"; fail=1 ;;
    server/whitelist.json|server/ops.json|network/tailscale-policy.hujson)
                             echo "pre-commit: local data blocked (players or IP): $f"; fail=1 ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACM)

if git diff --cached -U0 --diff-filter=ACM \
   | grep -E '^\+(rcon\.password|management-server-secret|RCON_PASS|MGMT_SECRET)=.+' >/dev/null; then
  echo "pre-commit: secret value found in the diff (rcon.password, management-server-secret, RCON_PASS or MGMT_SECRET)"
  fail=1
fi

exit $fail
