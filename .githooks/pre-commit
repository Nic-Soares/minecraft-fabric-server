#!/usr/bin/env bash
# Bloqueia segredos e binários antes do commit.
set -euo pipefail
fail=0

while IFS= read -r f; do
  case "$f" in
    *.jar|*.zst|*.mca|*.dat) echo "pre-commit: binário bloqueado: $f"; fail=1 ;;
    .env|*/.env)             echo "pre-commit: arquivo de segredo bloqueado: $f"; fail=1 ;;
    server/whitelist.json|server/ops.json|network/tailscale-policy.hujson)
                             echo "pre-commit: dado local bloqueado (jogadores ou IP): $f"; fail=1 ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACM)

if git diff --cached -U0 --diff-filter=ACM \
   | grep -E '^\+(rcon\.password|management-server-secret|RCON_PASS|MGMT_SECRET)=.+' >/dev/null; then
  echo "pre-commit: valor de segredo encontrado no diff (rcon.password, management-server-secret, RCON_PASS ou MGMT_SECRET)"
  fail=1
fi

exit $fail
