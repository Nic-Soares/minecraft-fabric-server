<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.minecraft-fabric-server</string>
  <key>ProgramArguments</key>
  <array><string>~/Servers/minecraft/scripts/start.sh</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ExitTimeOut</key><integer>90</integer>
  <key>StandardOutPath</key><string>~/Servers/minecraft/server/logs/launchd.out</string>
  <key>StandardErrorPath</key><string>~/Servers/minecraft/server/logs/launchd.err</string>
</dict>
</plist>
