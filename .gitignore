# macOS
.DS_Store

# local secrets (the versioned template is scripts/.env.example)
.env
scripts/.env

# real Tailscale policy, with the Mac's IP (template: .example.hujson)
network/tailscale-policy.hujson

# launchd job generated by scripts/service.sh (template: .template)
launchd/minecraft.plist

# world snapshots: large binaries, kept out of Git
backups/

# server runtime: everything ignored except what describes the configuration.
# whitelist.json and ops.json stay out: they hold player names and UUIDs.
server/*
!server/server.properties.base
!server/config/

# Python
__pycache__/
server/config/spark/tmp/
